# Copy this file to .env and fill in the values. Never commit .env.

# Sign in with Google: create an OAuth client ID ("Web application") at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public address of the site, used to build the Google redirect URI
# (<PUBLIC_URL>/api/auth/google/callback). Leave empty locally.
PUBLIC_URL=

# Card payments through Stripe Connect (optional). Use test keys (sk_test_…) until you go live.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing secret of your webhook endpoint (<site>/api/payments/webhook), or the one printed by
# `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=
