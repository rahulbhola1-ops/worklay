{
  "name": "worklay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,vite -c cyan,magenta \"node server.mjs --dev\" \"vite --host 127.0.0.1 --port 5173\"",
    "build": "vite build",
    "start": "node server.mjs",
    "check": "npm run build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "node db/migrate.mjs",
    "db:migrate:down": "node db/migrate.mjs down",
    "db:import-sqlite": "node db/import-sqlite.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "better-sqlite3": "13.2.0",
    "express": "5.3.0",
    "kysely": "0.29.9",
    "multer": "2.0.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "vite": "8.3.8"
  }
}
